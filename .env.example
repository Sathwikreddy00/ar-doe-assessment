# ============================================================
# Environment Configuration Template
# Copy this file to .env and fill in values for your environment
#   cp .env.example .env
# .env is git-ignored and should never be committed
# ============================================================

# ---- Server ------------------------------------------------
# Port the application listens on
SERVER_PORT=9090

# ---- Database ----------------------------------------------
# H2 in-memory database URL
# DB_CLOSE_DELAY=-1 keeps the DB alive as long as the JVM runs
SPRING_DATASOURCE_URL=jdbc:h2:mem:usersdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# ---- Logging -----------------------------------------------
# Set to DEBUG for verbose output, INFO for normal, WARN for minimal
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=DEBUG
